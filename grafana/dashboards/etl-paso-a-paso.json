      {
        "name": "registro",
        "label": "Registro",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${entorno}"
        },
        "query": "SELECT titulo AS __text, trace_id AS __value FROM gold.etl_trace ORDER BY created_at DESC, CASE dq_status WHEN 'VALID' THEN 1 WHEN 'WARNING' THEN 2 ELSE 3 END, trace_id LIMIT 60",
        "definition": "Muestras de los últimos lotes",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "El camino de este registro",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "¿Por dónde pasó el registro elegido?",
      "description": "Las etapas en color son las que recorrió el registro elegido arriba (selector «Registro»); las grises son las que no le tocaron.",
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${entorno}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'fuente' AS id, '1 · EXTRACCIÓN' AS title, 'fuente' AS subtitle, (t.source) AS secondarystat, ('#898781') AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t UNION ALL SELECT 'bronze' AS id, '2 · BRONZE' AS title, 'Parquet · crudo' AS subtitle, ('guardado') AS secondarystat, ('#d95926') AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t UNION ALL SELECT 'reglas' AS id, '3 · VALIDACIÓN' AS title, 'reglas DQ01–DQ12' AS subtitle, (CASE t.dq_status WHEN 'VALID' THEN '✔ cumple' WHEN 'WARNING' THEN '⚠ warning' ELSE '✖ rechaza' END) AS secondarystat, ('#898781') AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t UNION ALL SELECT 'silver' AS id, '4 · SILVER' AS title, 'Parquet · validado' AS subtitle, (CASE WHEN t.dq_status = 'INVALID' THEN 'no pasa' ELSE '✔ llega' END) AS secondarystat, (CASE WHEN t.dq_status = 'INVALID' THEN '#3a3d42' ELSE '#3987e5' END) AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t UNION ALL SELECT 'quarantine' AS id, '4 · QUARANTINE' AS title, 'Parquet · rechazados' AS subtitle, (CASE WHEN t.dq_status = 'INVALID' THEN '✖ queda' ELSE 'no pasa' END) AS secondarystat, (CASE WHEN t.dq_status = 'INVALID' THEN '#d03b3b' ELSE '#3a3d42' END) AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t UNION ALL SELECT 'gold' AS id, '5 · GOLD' AS title, 'PostgreSQL · indicadores' AS subtitle, (CASE WHEN t.dq_status = 'INVALID' THEN 'no llega' ELSE '✔ aporta' END) AS secondarystat, (CASE WHEN t.dq_status = 'INVALID' THEN '#3a3d42' ELSE '#c98500' END) AS color FROM (SELECT * FROM gold.etl_trace WHERE trace_id = '$registro') t"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${entorno}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'e1' AS id, 'fuente' AS source, 'bronze' AS target UNION ALL SELECT 'e2' AS id, 'bronze' AS source, 'reglas' AS target UNION ALL SELECT 'e3' AS id, 'reglas' AS source, 'silver' AS target UNION ALL SELECT 'e4' AS id, 'reglas' AS source, 'quarantine' AS target UNION ALL SELECT 'e5' AS id, 'silver' AS source, 'gold' AS target"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
