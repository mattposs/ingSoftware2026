    {
      "type": "dashboards",
      "tags": [
        "agro"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "entorno",
        "label": "Entorno",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "regex": "/^Agro · /",
