{
  "uid": "agro-paso-a-paso",
  "title": "ETL paso a paso",
  "description": "Un registro real recorriendo las 5 etapas del pipeline: extracción, Bronze, validación, Silver/Quarantine y Gold.",
  "tags": [
    "agro",
    "dataops",
    "etl"
  ],
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
