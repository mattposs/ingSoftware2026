          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ((m.fecha + time '12:00') AT TIME ZONE 'America/Argentina/Buenos_Aires') AS time, f.field_id || ' · ' || f.nombre AS metric, m.temperatura_promedio AS value FROM gold.daily_field_metrics m JOIN gold.fields f USING (field_id) WHERE m.fuente = '$fuente' AND m.field_id IN ($campo) AND $__timeFilter(((m.fecha + time '12:00') AT TIME ZONE 'America/Argentina/Buenos_Aires')) ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
