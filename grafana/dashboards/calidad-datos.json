          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT run_start AS time, dq_score AS \"DQ Score\" FROM gold.dq_run_metrics WHERE status = 'ok' AND $__timeFilter(run_start) ORDER BY 1"
