        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.1,
        "xField": "Regla",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
