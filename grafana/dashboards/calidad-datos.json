    {
      "type": "stat",
      "title": "DQ Score",
      "description": "(VALID + WARNING) / total × 100 de la última corrida. Verde ≥ 95%, amarillo ≥ 90%, rojo < 90%.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${entorno}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT dq_score AS \"DQ Score\" FROM gold.dq_run_metrics WHERE status = 'ok' ORDER BY run_start DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 90
              },
              {
                "color": "#0ca30c",
                "value": 95
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
