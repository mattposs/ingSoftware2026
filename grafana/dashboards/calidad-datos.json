    {
      "type": "barchart",
      "title": "Hallazgos por regla (todas las fuentes)",
      "description": "Cantidad de hallazgos de cada regla DQ01–DQ12 en el período. Rechazos = registro a quarantine; warnings = publicado y marcado.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${entorno}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH reglas(rule_id) AS (SELECT 'DQ' || lpad(g::text, 2, '0') FROM generate_series(1, 12) g) SELECT r.rule_id AS \"Regla\", NULLIF(count(e.*) FILTER (WHERE e.action = 'REJECT'), 0) AS \"Rechazos\", NULLIF(count(e.*) FILTER (WHERE e.action = 'WARNING'), 0) AS \"Warnings\" FROM reglas r LEFT JOIN gold.dq_errors e ON e.rule_id = r.rule_id AND e._batch_id IN (SELECT _batch_id FROM gold.dq_run_metrics WHERE $__timeFilter(run_start)) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 100,
            "gradientMode": "none",
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Rechazos"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warnings"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fab219"
                }
              }
            ]
          }
        ]
      },
