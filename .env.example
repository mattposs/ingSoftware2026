# Valores por defecto de desarrollo: el código y docker compose leen este archivo directamente.
# Para contraseñas propias, copiar a .env (ignorado por Git, pisa estos valores). Nunca commitear .env.

# Superusuario de PostgreSQL (solo lo usa el contenedor para inicializar la base)
POSTGRES_DB=postgres   # las bases agro_dev / agro_staging / agro_prod las crea sql/00_entornos.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Usuario con permisos mínimos que usa el pipeline (RNF07)
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=cambiar-esto-tambien

# Usuario de solo lectura para Grafana / Power BI
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=cambiar-esto-tambien

# Grafana (dashboard en http://localhost:3000, usuario admin)
GRAFANA_ADMIN_PASSWORD=cambiar-esto-tambien
# GRAFANA_PORT=3000

# Cada cuántos segundos corre el pipeline programado (servicio scheduler)
PIPELINE_INTERVAL_SECONDS=900

# Entorno para correr el pipeline desde tu máquina: dev (defecto), staging o prod
APP_ENV=dev

# Opcional: URL completa (pisa las variables anteriores y el entorno)
# DATABASE_URL=postgresql+psycopg://pipeline:password@localhost:5432/agro_dev

# Opcional: raíz del lake Parquet (por defecto storage/<entorno>/)
# STORAGE_PATH=storage

# --- Alertas del pipeline (Grafana Alerting, grafana/provisioning/alerting/) ---
# Umbrales: se cambian acá (o en .env) y se aplican con: docker compose up -d grafana
ALERT_AL01_MINUTOS_SIN_CORRIDAS=30   # AL01: minutos sin filas nuevas en gold.dq_run_metrics (2 ciclos de 15 min)
ALERT_AL02_DQ_SCORE_MINIMO=80        # AL02: DQ Score estricto mínimo de la última corrida (%)
ALERT_AL02_CAIDA_MAXIMA_PUNTOS=10    # AL02: caída máxima contra el promedio de las 24 h anteriores (puntos)
# Correo de las notificaciones: lo recibe Mailpit (http://localhost:8025), no sale a internet
ALERT_EMAIL_TO=equipo-datos@datumsur.local
ALERT_EMAIL_FROM=grafana@datumsur.local
# MAILPIT_PORT=8025

# --- Solo para probar las alertas (scripts/simulate_alerts.py). Dejar apagado. ---
# PIPELINE_FORCE_FAILURE=true        # la corrida falla a propósito y queda registrada como FAILED (AL01)
# PIPELINE_IOT_ERROR_RATE=0.5        # pisa error_rate del simulador IoT para bajar el DQ Score (AL02)
