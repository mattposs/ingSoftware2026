# Copiar a .env (ignorado por Git) y completar contraseñas. Nunca commitear .env.

# Superusuario de PostgreSQL (solo lo usa el contenedor para inicializar la base)
POSTGRES_DB=postgres   # las bases agro_dev / agro_staging / agro_prod las crea sql/00_entornos.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Usuario con permisos mínimos que usa el pipeline (RNF07)
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=cambiar-esto-tambien

# Usuario de solo lectura para Grafana / Power BI
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=cambiar-esto-tambien

# Grafana (dashboard en http://localhost:3000, usuario admin)
GRAFANA_ADMIN_PASSWORD=cambiar-esto-tambien
# GRAFANA_PORT=3000

# Cada cuántos segundos corre el pipeline programado (servicio scheduler)
PIPELINE_INTERVAL_SECONDS=900

# Entorno para correr el pipeline desde tu máquina: dev (defecto), staging o prod
APP_ENV=dev

# Opcional: URL completa (pisa las variables anteriores y el entorno)
# DATABASE_URL=postgresql+psycopg://pipeline:password@localhost:5432/agro_dev

# Opcional: raíz del lake Parquet (por defecto storage/<entorno>/)
# STORAGE_PATH=storage
